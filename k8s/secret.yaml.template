apiVersion: v1
kind: Secret
metadata:
  name: db-secret
  namespace: rarego
type: Opaque
stringData:
  username: "${DB_USERNAME}"
  password: "${DB_PASSWORD}"
---
apiVersion: v1
kind: Secret
metadata:
  name: jwt-secret
  namespace: rarego
type: Opaque
stringData:
  secret: "${JWT_SECRET}"
---
apiVersion: v1
kind: Secret
metadata:
  name: toss-secret
  namespace: rarego
type: Opaque
stringData:
  secret-key: "${TOSS_PAYMENTS_SECRET_KEY}"
---
apiVersion: v1
kind: Secret
metadata:
  name: aws-secret
  namespace: rarego
type: Opaque
stringData:
  access-key: "${AWS_ACCESS_KEY}"
  secret-key: "${AWS_SECRET_KEY}"
---
apiVersion: v1
kind: Secret
metadata:
  name: oauth-secret
  namespace: rarego
type: Opaque
stringData:
  google-id: "${GOOGLE_CLIENT}"
  google-secret: "${GOOGLE_SECRET}"
  kakao-id: "${KAKAO_CLIENT}"
  naver-id: "${NAVER_CLIENT}"
  naver-secret: "${NAVER_SECRET}"
---
apiVersion: v1
kind: Secret
metadata:
  name: global-secret
  namespace: rarego
type: Opaque
stringData:
  # Database Extra
  DB_NAME: "${DB_NAME}"
  DB_ROOT_PASSWORD: "${DB_ROOT_PASSWORD}"
  DB_PORT: "${DB_PORT}"
  
  # App Config
  TZ: "${TZ}"
  FRONT_URL: "${FRONT_URL}"
  SPRING_PROFILES_ACTIVE: "${SPRING_PROFILES_ACTIVE}"
  
  # Infrastructure
  REDIS_HOST: "${REDIS_HOST}"
  REDIS_PORT: "${REDIS_PORT}"
  KAFKA_BOOTSTRAP_SERVERS: "${KAFKA_BOOTSTRAP_SERVERS}"
  ELASTICSEARCH_URIS: "${ELASTICSEARCH_URIS}"
  OPENAI_API_KEY: "${OPENAI_API_KEY}"
  GEMINI_API_KEY: "${GEMINI_API_KEY}"
  
  # Monitoring & Ingress
  GRAFANA_ADMIN_USER: "${GRAFANA_ADMIN_USER}"
  GRAFANA_ADMIN_PASSWORD: "${GRAFANA_ADMIN_PASSWORD}"
  GF_SERVER_ROOT_URL: "${GF_SERVER_ROOT_URL}"
  GF_SERVER_SERVE_FROM_SUB_PATH: "${GF_SERVER_SERVE_FROM_SUB_PATH}"
  NGINX_BASIC_AUTH_USER: "${NGINX_BASIC_AUTH_USER}"
  NGINX_BASIC_AUTH_PASS: "${NGINX_BASIC_AUTH_PASS}"
---
apiVersion: v1
kind: Secret
metadata:
  name: monitoring-auth
  namespace: rarego
type: Opaque
stringData:
  # .htpasswd format: user:pass (hashed recommended)
  # Generated via: printf "user:$(openssl passwd -apr1 pass)\n"
  auth: "${NGINX_BASIC_AUTH_HTPASSWD}"


